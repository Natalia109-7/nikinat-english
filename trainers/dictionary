{c:"insect",e:"Insects",r:"Насекомые",p:"332",n:"Бабочки: monarch, swallowtail. Жуки: ladybug, stag beetle. Другие: bee, wasp, ant, mosquito, fly, dragonfly, grasshopper, cricket, spider, scorpion."},
{c:"rep",e:"Reptiles and Amphibians",r:"Рептилии и амфибии",p:"334",n:"Рептилии: snake, lizard, turtle, crocodile, alligator, chameleon. Амфибии: frog, toad, salamander, newt, axolotl."},
{c:"ocean",e:"Ocean Life",r:"Морская жизнь",p:"340",n:"Киты: blue whale, sperm whale, killer whale, humpback. Рыбы: shark, tuna, salmon, cod. Беспозвоночные: octopus, squid, jellyfish, coral, starfish, crab."},
{c:"plant1",e:"Plants and Trees",r:"Растения и деревья",p:"342",n:"Деревья: oak, birch, maple, pine, spruce, willow, cedar. Цветы: rose, tulip, daisy, orchid, lily. Хищные: Venus flytrap, pitcher plant, sundew."},
{c:"fungi",e:"Fungi",r:"Грибы",p:"348",n:"Съедобные: porcini, chanterelle, morel, shiitake, button. Ядовитые: fly agaric, death cap. Части: cap, stem, gills, spores, mycelium."},
{c:"time",e:"Time",r:"Время",p:"350",n:"Время: o'clock, half past, quarter past, quarter to. Части суток: dawn, morning, midday, afternoon, evening, dusk, night, midnight."},
{c:"cal",e:"Calendar",r:"Календарь",p:"352",n:"Дни: Monday-Sunday. Месяцы: January-December. Сезоны: spring, summer, autumn/fall, winter. Периоды: week, month, year, decade, century, millennium."},
{c:"num",e:"Numbers",r:"Числа",p:"354",n:"Порядковые: first, second, third, tenth. Дроби: half, quarter, third, three-fifths. Большие: million, billion, trillion. Десятичные: point five."},
{c:"meas",e:"Weights and Measures",r:"Меры",p:"356",n:"Вес: gram, kilogram, ounce, pound, tonne. Длина: millimeter, centimeter, meter, kilometer, inch, foot, yard, mile. Объём: milliliter, liter, pint, quart, gallon."},
{c:"writ",e:"Writing",r:"Письмо",p:"358",n:"Знаки: comma, period, semicolon, colon, apostrophe, hyphen, dash. Алфавиты: Latin, Cyrillic, Greek, Arabic, Chinese, Japanese, Braille."},
{c:"adj1",e:"Describing Things",r:"Прилагательные",p:"360",n:"Антонимы: shiny-dull, stiff-flexible, narrow-wide, shallow-deep. Материалы: wood, leather, rubber, ceramic, fiberglass. Мнения: breathtaking, stunning, hilarious, dreadful."},
{c:"phr",e:"Phrasal Verbs",r:"Фразовые глаголы",p:"364",n:"Примеры: run out of (заканчиваться), wait up (не ложась спать), doze off (задремать), trip over (споткнуться), pile up (накапливаться), log in/out."},
{c:"expr1",e:"Useful Expressions",r:"Полезные выражения",p:"366",n:"Знакомство: What's your name? — My name is... How old are you? — I'm 25. Покупки: How much is this? — It's 15 dollars. I'm just browsing, thanks."},
{c:"caves",e:"Caves and Caving",r:"Пещеры",p:"301",n:"Сталактит свисает с потолка (c = ceiling), сталагмит растёт снизу (g = ground); срастаясь, они образуют колонну. Обязательны helmet и headlamp."}
];

/* ================= ЛОГИКА ================= */
const app=document.getElementById("app");
let stats={correct:0,total:0,streak:0};try{Object.assign(stats,JSON.parse(localStorage.getItem("st_v2")||"{}"))}catch(e){}
let imgOv={};try{Object.assign(imgOv,JSON.parse(localStorage.getItem("img_v2")||"{}"))}catch(e){}
const getImg=k=>imgOv[k]||IMG[k]||"";
function setImg(k,u){imgOv[k]=u;localStorage.setItem("img_v2",JSON.stringify(imgOv));}
function updSt(){document.getElementById("stC").textContent=stats.correct;document.getElementById("stT").textContent=stats.total;document.getElementById("stA").textContent=stats.total?Math.round(100*stats.correct/stats.total)+"%":"–";document.getElementById("stS").textContent=stats.streak;localStorage.setItem("st_v2",JSON.stringify(stats));}
updSt();
const shuffle=a=>{a=[...a];for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;};
const rnd=a=>a[Math.floor(Math.random()*a.length)];
const esc=s=>s.replace(/'/g,"\\'");
function speak(t){if(!("speechSynthesis"in window))return;speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(t);u.lang="en-US";u.rate=.9;speechSynthesis.speak(u);}
let Q=null,timerId=null,timeLeft=15,dir="en2ru";
function startTimer(end){clearInterval(timerId);timeLeft=15;const f=document.querySelector(".timer-fill"),x=document.getElementById("tTxt");const u=()=>{if(f){f.style.width=(timeLeft/15*100)+"%";if(timeLeft<=5)f.classList.add("warn");}if(x)x.textContent=timeLeft+"с";};u();timerId=setInterval(()=>{timeLeft--;u();if(timeLeft<=0){clearInterval(timerId);end();}},1000);}

function home(){clearInterval(timerId);app.innerHTML=`
<div class="mode-toggle"><button class="${dir==="en2ru"?"active":""}" onclick="setDir('en2ru')">EN → RU</button><button class="${dir==="ru2en"?"active":""}" onclick="setDir('ru2en')">RU → EN</button></div>
<div class="nav-grid">
<div class="nav-card" onclick="startTheory()"><div class="ico">📖</div><h3>Theory · ${THEORY.length} topics</h3><div class="sub">Теория с картинками</div><p>Конспекты всех страниц книги: правила, переводы и иллюстрации.</p></div>
<div class="nav-card" onclick="newQuiz()"><div class="ico">🎯</div><h3>Quiz</h3><div class="sub">Выбери перевод</div><p>${WORDS.length}+ слов с таймером 15 сек.</p></div>
<div class="nav-card" onclick="startTyping()"><div class="ico">⌨️</div><h3>Type</h3><div class="sub">Ввод с клавиатуры</div><p>Самый сложный режим.</p></div>
<div class="nav-card" onclick="startCards()"><div class="ico">🃏</div><h3>Flashcards</h3><div class="sub">Карточки</div><p>Переворачивай, оценивай.</p></div>
<div class="nav-card" onclick="newPhrasal()"><div class="ico">🧩</div><h3>Phrasal Verbs</h3><div class="sub">Фразовые глаголы</div><p>Заполни пропуски.</p></div>
<div class="nav-card" onclick="newCountries()"><div class="ico">🌍</div><h3>Countries</h3><div class="sub">Страны</div><p>Basotho, Burkinabe, Monégasque…</p></div>
<div class="nav-card" onclick="newOdd()"><div class="ico">🎭</div><h3>Odd One Out</h3><div class="sub">Найди лишнее</div><p>Тренируй категории.</p></div>
</div>
<div style="text-align:center;margin-top:20px"><button class="btn btn-ghost" onclick="resetAll()">🗑️ Сбросить прогресс</button></div>`;}
function setDir(d){dir=d;home();}
function resetAll(){if(confirm("Сбросить?")){localStorage.removeItem("st_v2");localStorage.removeItem("img_v2");stats={correct:0,total:0,streak:0};imgOv={};updSt();home();}}

function startTheory(){clearInterval(timerId);app.innerHTML=`<div class="quiz"><div class="top-bar"><div class="cat-tag">📖 Theory · ${THEORY.length} topics</div><div class="btns" style="margin:0"><button class="btn btn-ghost" onclick="exportIMG()">💾 Export</button><button class="btn btn-ghost" onclick="home()">← Menu</button></div></div><div class="nav-grid" style="margin-top:6px">${THEORY.map(t=>`<div class="nav-card" onclick="openTheory('${t.c}')">${getImg(t.c)?`<img class="thumb" src="${getImg(t.c)}">`:`<div class="thumb-ph">🖼️</div>`}<h3>${t.e}</h3><div class="sub">${t.r} · p. ${t.p}</div></div>`).join("")}</div></div>`;}
function openTheory(cat){const t=THEORY.find(x=>x.c===cat);const ws=WORDS.filter(w=>w.c===cat);const img=getImg(cat);
app.innerHTML=`<div class="quiz">
<div class="top-bar"><div class="cat-tag">p. ${t.p}</div><button class="btn btn-ghost" onclick="startTheory()">← Back</button></div>
<div class="word-display"><div class="word-main">${t.e}</div><div class="word-sub">${t.r}</div></div>
${img?`<img class="book-img" src="${img}" style="max-height:260px">`:`<div class="img-ph">🖼️ Картинка не добавлена</div>`}
<div class="btns"><button class="btn btn-ghost" onclick="pasteImg('${cat}')">🔗 Cloudinary URL</button>${img?`<button class="btn btn-ghost" onclick="setImg('${cat}','');openTheory('${cat}')">✕ Remove</button>`:""}</div>
<div class="note-box"><div class="nt">📚 Теория</div>${t.n}</div>
${cat==="phr"?`<div class="wordlist">${PHRASAL.map(p=>`<div class="wrow"><button class="mini-s" onclick="speak('${esc(p.a)}')">🔊</button><span class="en">${p.a}</span><span class="ru">${p.ru}</span></div>`).join("")}</div>`:
cat==="countries"?`<div class="wordlist">${COUNTRIES.map(c=>`<div class="wrow"><button class="mini-s" onclick="speak('${esc(c[0])}')">🔊</button><span class="en">${c[0]}</span><span class="ru">${c[1]}</span></div>`).join("")}</div>`:
`<div class="wordlist">${ws.slice(0,50).map(w=>`<div class="wrow"><button class="mini-s" onclick="speak('${esc(w.e)}')">🔊</button><span class="en">${w.e}</span><span class="ru">${w.r}</span></div>`).join("")}${ws.length>50?`<div class="wrow"><em>...и ещё ${ws.length-50} слов</em></div>`:""}</div>`}
<div class="btns"><button class="btn btn-primary" onclick="newQuiz('${cat}')">🎯 Quiz</button><button class="btn btn-primary" onclick="startTyping('${cat}')">⌨️ Type</button></div>
</div>`;}
function pasteImg(cat){const u=prompt("Cloudinary URL:");if(u&&u.startsWith("http")){setImg(cat,u.trim());openTheory(cat);}}
function exportIMG(){
  const code="const IMG={\n"+Object.keys(imgOv).map(k=>k+': "'+imgOv[k]+'"').join(",\n")+"\n};";
  const d=document.createElement("div");d.id="expOverlay";
  d.style.cssText="position:fixed;inset:0;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;z-index:99";
  d.innerHTML='<div style="background:#fff;border-radius:16px;padding:20px;max-width:640px;width:92%"><h3>Скопируйте и замените IMG</h3><textarea id="expTa" style="width:100%;height:260px;font-family:monospace;font-size:12px"></textarea><div style="margin-top:10px;display:flex;gap:10px"><button class="btn btn-primary" onclick="copyExp()">📋 Copy</button><button class="btn btn-ghost" onclick="document.getElementById(\'expOverlay\').remove()">Close</button></div></div>';
  document.body.appendChild(d);document.getElementById("expTa").value=code;}
function copyExp(){const t=document.getElementById("expTa");t.select();document.execCommand("copy");}

function showQuiz(o){clearInterval(timerId);Q=o;const img=o.imgKey&&getImg(o.imgKey)?`<img class="book-img" src="${getImg(o.imgKey)}">`:"";
app.innerHTML=`<div class="quiz"><div class="top-bar"><div class="cat-tag">${o.sub||""}</div><div class="timer-wrap">⏱️ <span id="tTxt">15с</span><div class="timer"><div class="timer-fill"></div></div></div></div>
<div class="word-display"><div class="word-main">${o.prompt}</div>${img}<button class="sound-btn" onclick="speak('${esc(o.prompt)}')">🔊</button></div>
${o.options?`<div class="opts">${o.options.map((x,i)=>`<button class="opt" onclick="checkAns(${i})"><span class="letter">${String.fromCharCode(65+i)}</span>${x.t}</button>`).join("")}</div>`:""}
${o.hasInput?`<input type="text" class="type-input" id="typeIn" placeholder="Type your answer..." autocomplete="off" spellcheck="false"><div class="hint">Enter — проверить</div>`:""}
<div class="info-box" id="infoBox"></div>
<div class="btns"><button class="btn btn-ghost" onclick="home()">← Menu</button><button class="btn btn-primary" id="nextBtn" style="display:none" onclick="Q.next()">Next →</button></div></div>`;
if(o.hasInput){const i=document.getElementById("typeIn");i.focus();i.addEventListener("keydown",e=>{if(e.key==="Enter"&&!i.disabled)checkType();});}
startTimer(timeOut);}
function timeOut(){if(Q.hasInput){const i=document.getElementById("typeIn");if(i)i.disabled=true;}else{document.querySelectorAll(".opt").forEach((b,i)=>{b.disabled=true;if(Q.options[i].ok)b.classList.add("correct");});}
stats.total++;stats.streak=0;updSt();const x=document.getElementById("infoBox");x.innerHTML="⏰ <b>Time's up!</b> "+Q.info;x.classList.add("show");document.getElementById("nextBtn").style.display="inline-block";}
function checkAns(i){clearInterval(timerId);const b=[...document.querySelectorAll(".opt")];b.forEach((x,idx)=>{x.disabled=true;if(Q.options[idx].ok)x.classList.add("correct");});if(!Q.options[i].ok)b[i].classList.add("wrong");record(Q.options[i].ok);}
function checkType(){clearInterval(timerId);const i=document.getElementById("typeIn");const v=i.value.trim().toLowerCase();const ok=Q.onType(v);i.disabled=true;i.classList.add(ok?"correct":"wrong");record(ok);}
function record(ok){stats.total++;if(ok){stats.correct++;stats.streak++;}else stats.streak=0;updSt();const x=document.getElementById("infoBox");x.innerHTML=(ok?"✅ <b>Great!</b> ":"❌ <b>Not quite.</b> ")+Q.info;x.classList.add("show");document.getElementById("nextBtn").style.display="inline-block";}

function newQuiz(cat){const src=cat?WORDS.filter(w=>w.c===cat):WORDS;const w=rnd(src);const e2r=dir==="en2ru";
const pool=shuffle(WORDS.filter(x=>x!==w&&x.r!==w.r)).slice(0,3);
showQuiz({prompt:e2r?w.e:w.r,sub:CATS[w.c],imgKey:w.c,options:shuffle([{t:e2r?w.r:w.e,ok:true},...pool.map(x=>({t:e2r?x.r:x.e,ok:false}))]),info:`${w.e} — <b>${w.r}</b>`,next:()=>newQuiz(cat)});}
function startTyping(cat){const src=cat?WORDS.filter(w=>w.c===cat):WORDS;const w=rnd(src);const e2r=dir==="en2ru";
showQuiz({prompt:e2r?w.e:w.r,sub:CATS[w.c]+" · typing",imgKey:w.c,hasInput:true,onType:v=>{const a=(e2r?w.r:w.e).toLowerCase().replace(/[()]/g,"").trim();return v===a||v===(e2r?w.r:w.e).toLowerCase();},info:`Answer: <b>${e2r?w.r:w.e}</b>`,next:()=>startTyping(cat)});}
function startCards(){const deck=shuffle(WORDS).slice(0,15);let i=0,k=0,d=0;const show=()=>{if(i>=deck.length){app.innerHTML=`<div class="quiz" style="text-align:center"><div style="font-size:56px">🎉</div><h2>Done!</h2><div class="word-sub">Knew: ${k} · Didn't: ${d}</div><div class="btns"><button class="btn btn-ghost" onclick="home()">← Menu</button><button class="btn btn-primary" onclick="startCards()">Again</button></div></div>`;return;}
const w=deck[i];const img=getImg(w.c)?`<img class="book-img" src="${getImg(w.c)}">`:"";
app.innerHTML=`<div class="quiz"><div class="top-bar"><div class="cat-tag">${CATS[w.c]} · ${i+1}/${deck.length}</div><div class="timer-wrap">✅${k} ❌${d}</div></div>
<div class="word-display" style="cursor:pointer" onclick="flip(this)" data-f="0"><div class="word-main" id="cw">${w.e}</div><div class="word-sub" id="cs">click for translation</div>${img}<button class="sound-btn" onclick="event.stopPropagation();speak('${esc(w.e)}')">🔊</button></div>
<div class="btns"><button class="btn btn-ghost" onclick="home()">← Menu</button><button class="btn" style="background:#fbe3e0;color:#8b3a3a" onclick="cAns(0)">✕ Didn't know</button><button class="btn" style="background:#e8f0dd;color:#4a6a3a" onclick="cAns(1)">✓ Knew</button></div></div>`;
window._w=w;};
window.flip=el=>{const w=window._w;if(el.dataset.f==="0"){document.getElementById("cw").textContent=w.r;document.getElementById("cs").textContent=w.e;el.dataset.f="1";speak(w.e);}else{document.getElementById("cw").textContent=w.e;document.getElementById("cs").textContent="click for translation";el.dataset.f="0";}};
window.cAns=v=>{v?k++:d++;i++;show();};show();}
function newPhrasal(){const p=rnd(PHRASAL);showQuiz({prompt:p.s,sub:"Phrasal verbs",imgKey:"phr",options:shuffle(p.o.map(t=>({t,ok:t===p.a}))),info:`✔ <b>${p.ru}</b>`,next:newPhrasal});}
function newCountries(){const c=rnd(COUNTRIES);const pool=shuffle(COUNTRIES.filter(x=>x[0]!==c[0]&&x[1]!==c[1])).slice(0,3);
showQuiz({prompt:c[0],sub:"Countries",imgKey:"countries",options:shuffle([{t:c[1],ok:true},...pool.map(x=>({t:x[1],ok:false}))]),info:`${c[0]} → <b>${c[1]}</b>`,next:newCountries});}
function newOdd(){const cats=[...new Set(WORDS.map(w=>w.c))].filter(c=>WORDS.filter(w=>w.c===c).length>=4);const a=rnd(cats);let b=rnd(cats);while(b===a)b=rnd(cats);
const three=shuffle(WORDS.filter(w=>w.c===a)).slice(0,3);const one=rnd(WORDS.filter(w=>w.c===b));
showQuiz({prompt:"🎭 Odd one out",sub:"Find the odd one",options:shuffle([...three.map(w=>({t:w.e,ok:false})),{t:one.e,ok:true}]),info:`Odd: <b>${one.e}</b> — ${one.r} (${CATS[b]}); rest — ${CATS[a]}`,next:newOdd});}
home();
console.log(`Loaded: ${WORDS.length} words, ${THEORY.length} theory topics, ${Object.keys(CATS).length} categories`);
</script>
</body>
</html>
