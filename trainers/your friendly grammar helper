let currentChapter = 0;
let readChapters = JSON.parse(localStorage.getItem('readChapters') || '[]');

function renderToc() {
  const toc = document.getElementById('toc');
  const searchTerm = document.getElementById('search').value.toLowerCase();
  toc.innerHTML = '';
  chapters.forEach((ch, i) => {
    const text = (ch.title + ' ' + ch.subtitle).toLowerCase();
    if (searchTerm && !text.includes(searchTerm)) return;
    const li = document.createElement('li');
    li.innerHTML = `<span class="chapter-num">${i+1}.</span> ${ch.title}`;
    if (i === currentChapter) li.classList.add('active');
    if (readChapters.includes(i)) li.classList.add('read');
    li.onclick = () => {
      currentChapter = i;
      renderChapter();
      document.querySelector('.sidebar').classList.remove('open');
    };
    toc.appendChild(li);
  });
}

function renderChapter() {
  const ch = chapters[currentChapter];
  document.getElementById('chapterTitle').textContent = `Глава ${currentChapter + 1}. ${ch.title}`;
  document.getElementById('chapterSubtitle').textContent = ch.subtitle;
  let html = '';
  if (ch.greeting) {
    html += `<div class="greeting">${ch.greeting}</div>`;
  }
  html += ch.content;
  document.getElementById('chapterContent').innerHTML = html;
  document.getElementById('prevBtn').disabled = currentChapter === 0;
  document.getElementById('nextBtn').disabled = currentChapter === chapters.length - 1;
  document.querySelector('.main').scrollTop = 0;
  renderToc();
  updateProgress();
}

function navigate(dir) {
  const next = currentChapter + dir;
  if (next >= 0 && next < chapters.length) {
    currentChapter = next;
    renderChapter();
  }
}

function markRead() {
  if (!readChapters.includes(currentChapter)) {
    readChapters.push(currentChapter);
    localStorage.setItem('readChapters', JSON.stringify(readChapters));
    renderToc();
    updateProgress();
    const btn = document.querySelector('.mark-read');
    const originalText = btn.textContent;
    btn.textContent = 'Отлично! Так держать!';
    setTimeout(() => { btn.textContent = originalText; }, 2000);
  }
}

function updateProgress() {
  const total = chapters.length;
  const done = readChapters.length;
  document.getElementById('progressText').textContent = `${done} / ${total}`;
  document.getElementById('progressFill').style.width = (done / total * 100) + '%';
}

document.getElementById('search').addEventListener('input', renderToc);

document.addEventListener('keydown', (e) => {
  if (e.target.tagName === 'INPUT') return;
  if (e.key === 'ArrowLeft') navigate(-1);
  if (e.key === 'ArrowRight') navigate(1);
});

renderChapter();
</script>
